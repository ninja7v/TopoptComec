# Python compiled files
__pycache__/
*.py[cod]

# Saved results
# The whole directory is generated output: keeping it out of git means running
# the CLI or the GUI never makes the checkout dirty (which would block the
# updater, see docs/UPDATING.md).
/results/

# Test outputs
/tests/test_output*
/tests/*/*.npz
!/tests/references/
!/tests/references/*.npz
/tests/*/*_loss_function.csv
.coverage

# Build (when an executable is created)
/dist/
/build/
*.egg-info/

# Serena AI tool cache
.serena/

# Headroom generated files
AGENTS.md
