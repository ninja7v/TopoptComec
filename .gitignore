/tests/test_output*
/tests/*/*.npz
!/tests/references/
!/tests/references/*.npz
/tests/*/*_loss_function.csv
.coverage

# Build (when an executable is created)
/dist/
/build/
*.egg-info/

# Serena AI tool cache
.serena/

# Headroom generated files
AGENTS.md
